"use strict";
/*
 * 同詞聯想的伺服器（不需要安裝任何套件，只要有 Node.js 18 以上）。
 * 只做兩件事：提供遊戲網頁，以及在同一個房間的玩家之間轉送訊息。
 * 遊戲規則都在網頁裡，伺服器不判斷輸贏，也不儲存任何資料。
 */
const http = require("http");
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");

const PORT = process.env.PORT || 3000;
const INDEX = path.join(__dirname, "public", "index.html");

const ROOM_RE = /^[a-z0-9][a-z0-9_.-]{0,47}$/;
const TOPIC_RE = /^[a-z][a-z0-9_.-]{0,47}$/;
const ID_RE = /^[a-z0-9]{8,24}$/;
const MAX_PER_ROOM = 8;
const MAX_ROOMS = 500;
const MAX_CONNS = 2000;
const MAX_DATA_BYTES = 4096;
const MAX_PRESENCE_BYTES = 2048;
const MAX_FRAME = 16 * 1024;
const WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";

/* ------------------------------------------------------------------ */
/* 網頁                                                                */
/* ------------------------------------------------------------------ */
const server = http.createServer((req, res) => {
  const url = req.url.split("?")[0];
  if (url === "/healthz") {
    res.writeHead(200, { "content-type": "text/plain; charset=utf-8" });
    return res.end("ok");
  }
  if (url === "/" || url === "/index.html") {
    return fs.readFile(INDEX, (err, buf) => {
      if (err) {
        res.writeHead(500, { "content-type": "text/plain; charset=utf-8" });
        return res.end("找不到遊戲網頁");
      }
      res.writeHead(200, {
        "content-type": "text/html; charset=utf-8",
        "cache-control": "no-cache",
      });
      res.end(buf);
    });
  }
  res.writeHead(404, { "content-type": "text/plain; charset=utf-8" });
  res.end("not found");
});

/* ------------------------------------------------------------------ */
/* 最小的 WebSocket（RFC 6455）：文字訊息、ping/pong、關閉              */
/* ------------------------------------------------------------------ */
function encodeFrame(op, payload) {
  const len = payload.length;
  let header;
  if (len < 126) {
    header = Buffer.from([0x80 | op, len]);
  } else if (len < 65536) {
    header = Buffer.alloc(4);
    header[0] = 0x80 | op;
    header[1] = 126;
    header.writeUInt16BE(len, 2);
  } else {
    header = Buffer.alloc(10);
    header[0] = 0x80 | op;
    header[1] = 127;
    header.writeUInt32BE(0, 2);
    header.writeUInt32BE(len, 6);
  }
  return Buffer.concat([header, payload]);
}

class Conn {
  constructor(socket, id) {
    this.socket = socket;
    this.cid = id;
    this.open = true;
    this.alive = true;
    this.buf = Buffer.alloc(0);
    this.frags = [];
    this.fragOp = 0;
    this.fragLen = 0;
    this.myRooms = new Set();
    this.win = { start: Date.now(), n: 0 };
    this.onMessage = () => {};
    this.onClose = () => {};
    socket.setNoDelay(true);
    socket.on("data", (d) => this.onData(d));
    socket.on("close", () => this.finish());
    socket.on("error", () => this.finish());
  }
  finish() {
    if (!this.open) return;
    this.open = false;
    this.onClose();
  }
  write(buf) {
    if (this.open && !this.socket.destroyed) {
      try {
        this.socket.write(buf);
      } catch (e) {}
    }
  }
  sendText(text) {
    this.write(encodeFrame(0x1, Buffer.from(text, "utf8")));
  }
  ping() {
    this.write(encodeFrame(0x9, Buffer.alloc(0)));
  }
  close(code, reason) {
    if (!this.open) return;
    const r = Buffer.from(reason || "", "utf8");
    const p = Buffer.alloc(2 + r.length);
    p.writeUInt16BE(code || 1000, 0);
    r.copy(p, 2);
    this.write(encodeFrame(0x8, p));
    try {
      this.socket.end();
    } catch (e) {}
    setTimeout(() => {
      try {
        this.socket.destroy();
      } catch (e) {}
    }, 1000).unref();
  }
  terminate() {
    try {
      this.socket.destroy();
    } catch (e) {}
    this.finish();
  }
  onData(chunk) {
    this.buf = this.buf.length ? Buffer.concat([this.buf, chunk]) : chunk;
    for (;;) {
      const b = this.buf;
      if (b.length < 2) return;
      const fin = (b[0] & 0x80) !== 0;
      const op = b[0] & 0x0f;
      const masked = (b[1] & 0x80) !== 0;
      let len = b[1] & 0x7f;
      let off = 2;
      if (len === 126) {
        if (b.length < 4) return;
        len = b.readUInt16BE(2);
        off = 4;
      } else if (len === 127) {
        if (b.length < 10) return;
        if (b.readUInt32BE(2) !== 0) return this.close(1009, "too big");
        len = b.readUInt32BE(6);
        off = 10;
      }
      if (!masked) return this.close(1002, "unmasked");
      if (len > MAX_FRAME) return this.close(1009, "too big");
      if (b.length < off + 4 + len) return;
      const mask = b.subarray(off, off + 4);
      const payload = Buffer.from(b.subarray(off + 4, off + 4 + len));
      for (let i = 0; i < payload.length; i++) payload[i] ^= mask[i & 3];
      this.buf = b.subarray(off + 4 + len);
      this.onFrame(fin, op, payload);
      if (!this.open) return;
    }
  }
  onFrame(fin, op, payload) {
    if (op === 0x8) return this.close(1000, "");
    if (op === 0x9) return this.write(encodeFrame(0xa, payload));
    if (op === 0xa) {
      this.alive = true;
      return;
    }
    if (op === 0x1 || op === 0x2) {
      this.fragOp = op;
      this.frags = [payload];
      this.fragLen = payload.length;
    } else if (op === 0x0) {
      this.frags.push(payload);
      this.fragLen += payload.length;
      if (this.fragLen > MAX_FRAME) return this.close(1009, "too big");
    } else {
      return;
    }
    if (fin) {
      const msg = Buffer.concat(this.frags);
      this.frags = [];
      this.fragLen = 0;
      if (this.fragOp === 0x1) this.onMessage(msg.toString("utf8"));
    }
  }
}

let connCount = 0;

server.on("upgrade", (req, socket) => {
  let url;
  try {
    url = new URL(req.url, "http://localhost");
  } catch (e) {
    return socket.destroy();
  }
  const id = url.searchParams.get("id") || "";
  const key = req.headers["sec-websocket-key"];
  const isWs = String(req.headers.upgrade || "").toLowerCase() === "websocket";
  if (url.pathname !== "/ws" || !ID_RE.test(id) || !key || !isWs || connCount >= MAX_CONNS) {
    return socket.destroy();
  }
  const accept = crypto.createHash("sha1").update(key + WS_GUID).digest("base64");
  socket.write(
    "HTTP/1.1 101 Switching Protocols\r\n" +
      "Upgrade: websocket\r\n" +
      "Connection: Upgrade\r\n" +
      "Sec-WebSocket-Accept: " + accept + "\r\n\r\n"
  );
  connCount++;
  const conn = new Conn(socket, id);
  conns.add(conn);
  conn.onClose = () => {
    connCount--;
    conns.delete(conn);
    for (const name of Array.from(conn.myRooms)) removeFrom(name, conn);
  };
  conn.onMessage = (text) => handleMessage(conn, text);
});

const conns = new Set();

/* ------------------------------------------------------------------ */
/* 房間                                                                */
/* ------------------------------------------------------------------ */
/** rooms: 房間名 -> Map(玩家 id -> { conn, presence }) */
const rooms = new Map();

function broadcast(name, obj) {
  const room = rooms.get(name);
  if (!room) return;
  const text = JSON.stringify(obj);
  for (const entry of room.values()) entry.conn.sendText(text);
}

function broadcastPeers(name) {
  const room = rooms.get(name);
  if (!room) return;
  const peers = [];
  for (const [id, entry] of room) peers.push({ peer: id, presence: entry.presence });
  broadcast(name, { t: "peers", room: name, peers });
}

function removeFrom(name, conn) {
  conn.myRooms.delete(name);
  const room = rooms.get(name);
  if (!room) return;
  const entry = room.get(conn.cid);
  if (entry && entry.conn === conn) room.delete(conn.cid);
  if (room.size === 0) rooms.delete(name);
  else broadcastPeers(name);
}

function byteLength(v) {
  try {
    return Buffer.byteLength(JSON.stringify(v === undefined ? null : v), "utf8");
  } catch (e) {
    return Infinity;
  }
}

function handleMessage(conn, text) {
  const now = Date.now();
  if (now - conn.win.start > 1000) conn.win = { start: now, n: 0 };
  if (++conn.win.n > 80) return;

  let m;
  try {
    m = JSON.parse(text);
  } catch (e) {
    return;
  }
  if (!m || typeof m.room !== "string" || !ROOM_RE.test(m.room)) return;
  const name = m.room;

  if (m.t === "join") {
    let room = rooms.get(name);
    if (!room) {
      if (rooms.size >= MAX_ROOMS) {
        return conn.sendText(JSON.stringify({ t: "error", room: name, code: "busy" }));
      }
      room = new Map();
      rooms.set(name, room);
    }
    const existing = room.get(conn.cid);
    if (existing && existing.conn !== conn) {
      // 同一個人重新連線：用新的連線取代舊的，保留原本的狀態
      existing.conn.myRooms.delete(name);
      existing.conn.close(4000, "replaced");
    } else if (!existing && room.size >= MAX_PER_ROOM) {
      return conn.sendText(JSON.stringify({ t: "error", room: name, code: "full" }));
    }
    room.set(conn.cid, { conn, presence: existing ? existing.presence : {} });
    conn.myRooms.add(name);
    broadcastPeers(name);
    return;
  }

  const room = rooms.get(name);
  const entry = room && room.get(conn.cid);
  if (!entry || entry.conn !== conn) return;

  if (m.t === "leave") {
    removeFrom(name, conn);
  } else if (m.t === "presence") {
    if (!m.patch || typeof m.patch !== "object" || Array.isArray(m.patch)) return;
    const next = Object.assign({}, entry.presence);
    for (const k of Object.keys(m.patch)) {
      if (!/^[A-Za-z_][A-Za-z0-9_-]{0,63}$/.test(k)) continue;
      if (m.patch[k] === null) delete next[k];
      else next[k] = m.patch[k];
    }
    if (byteLength(next) > MAX_PRESENCE_BYTES) return;
    entry.presence = next;
    broadcastPeers(name);
  } else if (m.t === "emit") {
    if (typeof m.topic !== "string" || !TOPIC_RE.test(m.topic)) return;
    if (byteLength(m.data) > MAX_DATA_BYTES) return;
    broadcast(name, { t: "msg", room: name, topic: m.topic, peer: conn.cid, data: m.data });
  }
}

// 定期檢查連線，清掉已經斷掉的玩家；同時避免主機因為閒置而切斷連線
setInterval(() => {
  for (const conn of conns) {
    if (!conn.alive) {
      conn.terminate();
      continue;
    }
    conn.alive = false;
    conn.ping();
  }
}, 25000).unref();

server.listen(PORT, () => {
  console.log("同詞聯想已啟動：http://localhost:" + PORT);
});

